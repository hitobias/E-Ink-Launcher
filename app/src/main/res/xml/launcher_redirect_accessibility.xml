<?xml version="1.0" encoding="utf-8"?>
<!--
  Accessibility config for LauncherRedirectService.

  Purpose: listen ONLY for window state changes from the Supernote stock
  launcher (com.ratta.supernote.launcher) so we can immediately redirect
  back to E-Ink-Launcher when the user triggers the hardwired right-slider
  home gesture.

  Privacy-respecting:
  - canRetrieveWindowContent="false"  -> does not read screen content
  - packageNames pinned to the single Supernote launcher package
  - eventTypes pinned to TYPE_WINDOW_STATE_CHANGED only
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/launcher_redirect_description"
    android:notificationTimeout="50"
    android:packageNames="com.ratta.supernote.launcher"
    android:summary="@string/launcher_redirect_summary" />

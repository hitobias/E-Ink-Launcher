    <string name="setting_launcher_redirect">Redirect Supernote Right-Slider</string>
    <string name="launcher_redirect_description">Detects when the Supernote stock launcher comes to the foreground (via the hardwired right-slider gesture) and immediately switches back to E-Ink Launcher.</string>
    <string name="launcher_redirect_summary">Reclaims the Supernote right-slider home gesture for E-Ink Launcher.</string>
    <string name="launcher_redirect_steps">To use this:\n1. Re-enable \"Supernote Launcher\" in system Apps settings\n2. Tap OK, then grant accessibility access on the next screen\n3. Right-slider will then return to E-Ink Launcher</string>
